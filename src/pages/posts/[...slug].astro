---
import Terminal from '../../layouts/Terminal.astro';
import Section from '../../components/Section.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'posts'> };
const { Content, headings } = await render(post);
const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ id: h.slug, label: h.text, depth: h.depth }));
const date = post.data.date.toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---
<Terminal
  title={`${post.data.title} — Sathvik Rajampalli`}
  description={post.data.description ?? post.data.title}
  ogType="article"
  barTitle={`~/sathvik/posts — zsh — 96×30`}
  stamp={date}
  toc={toc}
  tocLabel="ls ~/outline"
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    datePublished: post.data.date.toISOString(),
    description: post.data.description,
    author: { '@type': 'Person', name: 'Sathvik Rajampalli' },
  })} />

  <a class="backlink" href="/">← Back to home <span class="hint">(cd ~)</span></a>

  <div class="prompt">
    <span class="ac">sathvik@columbia</span><span class="dm">:</span><span>~/posts</span><span class="dm">$</span> cat {post.id}.md
  </div>

  <Section title={post.data.title}>
    <div class="post-meta">{date}</div>
    <div class="prose" style="margin-top:18px">
      <Content />
    </div>
  </Section>

  <div style="margin-top:30px; font-size:15px">
    <span class="ac">sathvik@columbia</span><span class="dm">:</span><span>~/posts</span><span class="dm">$</span> <span class="caret"></span>
  </div>
</Terminal>
